#!/bin/bash

set -o nounset

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

COMMIT_MSG_FILE="$1"

if [ ! -f "$COMMIT_MSG_FILE" ]; then
  exit 0
fi

MSG=$(cat "$COMMIT_MSG_FILE" | head -1)

if echo "$MSG" | grep -qE '^(feat|fix|chore|refactor|docs|test)(\([a-zA-Z0-9_.-]+\))?!?: .+$'; then
  exit 0
fi

echo -e "${RED}⛔ Invalid commit message format.${NC}"
echo -e "${YELLOW}Expected: <type>(<scope>): <description>${NC}"
echo ""
echo "Valid types: feat, fix, chore, refactor, docs, test"
echo ""
echo "Examples:"
echo "  feat: add new command"
echo "  fix(auth): handle token expiry"
echo "  docs: update README"
echo "  refactor(api): simplify error handling"
echo ""
echo -e "${YELLOW}To bypass: git commit --no-verify${NC}"
exit 1
