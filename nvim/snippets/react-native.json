      "",
      "type RootStackParamList = {",
      "\t${1:ScreenName}: undefined;",
      "};",
      "",
      "type Props = NativeStackScreenProps<RootStackParamList, '${1:ScreenName}'>;",
      "",
      "const ${2:ComponentName} = ({ navigation }: Props) => {",
      "\treturn (",
      "\t\t<View style={styles.container}>",
      "\t\t\t<Text>$0</Text>",
      "\t\t</View>",
      "\t);",
      "};",
      "",
      "const styles = StyleSheet.create({",
      "\tcontainer: {",
      "\t\tflex: 1,",
      "\t\tjustifyContent: 'center',",
      "\t\talignItems: 'center',",
      "\t},",
      "});",
      "",
      "export default ${2:ComponentName};"
    ],
    "description": "React Native Stack Navigator screen"
  }
}
