{
  "React Native Functional Component": {
    "prefix": "rnfc",
    "body": [
      "import React from 'react';",
      "import { View, Text } from 'react-native';",
      "",
      "const ${1:ComponentName} = () => {",
      "\treturn (",
      "\t\t<View>",
      "\t\t\t<Text>$0</Text>",
      "\t\t</View>",
      "\t);",
      "};",
      "",
      "export default ${1:ComponentName};"
    ],
    "description": "React Native Functional Component"
  },
  "React Native FC with useState + StyleSheet": {
    "prefix": "rnfs",
    "body": [
      "import React, { useState } from 'react';",
      "import { View, Text, StyleSheet } from 'react-native';",
      "",
      "const ${1:ComponentName} = () => {",
      "\tconst [${2:state}, set${3:State}] = useState(${4:initialValue});",
      "",
      "\treturn (",
      "\t\t<View style={styles.container}>",
      "\t\t\t<Text>$0</Text>",
      "\t\t</View>",
      "\t);",
      "};",
      "",
      "const styles = StyleSheet.create({",
      "\tcontainer: {",
      "\t\tflex: 1,",
      "\t\tjustifyContent: 'center',",
      "\t\talignItems: 'center',",
      "\t},",
      "});",
      "",
      "export default ${1:ComponentName};"
    ],
    "description": "React Native FC with useState and StyleSheet"
  },
  "React Native FlatList": {
    "prefix": "rnfl",
    "body": [
      "import React from 'react';",
      "import { View, Text, FlatList, StyleSheet } from 'react-native';",
      "",
      "interface ${1:Item} {",
      "\t${2:id}: string;",
      "\t${3:name}: string;",
      "}",
      "",
      "const ${4:ComponentName} = () => {",
      "\tconst renderItem = ({ item }: { item: ${1:Item} }) => (",
      "\t\t<View>",
      "\t\t\t<Text>{item.${3:name}}</Text>",
      "\t\t</View>",
      "\t);",
      "",
      "\treturn (",
      "\t\t<FlatList",
      "\t\t\tdata={${5:data}}",
      "\t\t\trenderItem={renderItem}",
      "\t\t\tkeyExtractor={(item) => item.${2:id}}",
      "\t\t/>",
      "\t);",
      "};",
      "",
      "const styles = StyleSheet.create({",
      "\tcontainer: {",
      "\t\tflex: 1,",
      "\t},",
      "});",
      "",
      "export default ${4:ComponentName};"
    ],
    "description": "React Native FlatList component"
  },
  "React Native StyleSheet Component": {
    "prefix": "rnsf",
    "body": [
      "import React from 'react';",
      "import { View, Text, StyleSheet } from 'react-native';",
      "",
      "const ${1:ComponentName} = () => {",
      "\treturn (",
      "\t\t<View style={styles.container}>",
      "\t\t\t<Text style={styles.text}>$0</Text>",
      "\t\t</View>",
      "\t);",
      "};",
      "",
      "const styles = StyleSheet.create({",
      "\tcontainer: {",
      "\t\tflex: 1,",
      "\t\tjustifyContent: 'center',",
      "\t\talignItems: 'center',",
      "\t},",
      "\ttext: {",
      "\t\tfontSize: 16,",
      "\t},",
      "});",
      "",
      "export default ${1:ComponentName};"
    ],
    "description": "React Native component with StyleSheet"
  },
  "React Native Stack Screen": {
    "prefix": "rnav",
    "body": [
