{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#2d2a2e",
    "bgDark": "#221f22",
    "bgPanel": "#363436",
    "bgHighlight": "#403e41",
    "fg": "#fcfcfa",
    "fgDim": "#fcfcfab3",
    "comment": "#727072",
    "red": "#ff6188",
    "orange": "#fc9867",
    "yellow": "#ffd866",
    "green": "#a9dc76",
    "blue": "#78dce8",
    "purple": "#ab9df2",
    "pink": "#ff6188",
    "cyan": "#78dce8",
    "white": "#fcfcfa",
    "gray": "#727072",
    "lightGray": "#939293",
    "border": "#403e41",
    "borderLight": "#5b595c"
  },
  "theme": {
    "primary": { "dark": "purple", "light": "purple" },
    "secondary": { "dark": "blue", "light": "blue" },
    "accent": { "dark": "yellow", "light": "yellow" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "orange", "light": "orange" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "cyan", "light": "cyan" },
    "text": { "dark": "fg", "light": "fg" },
    "textMuted": { "dark": "gray", "light": "gray" },
    "background": { "dark": "bg", "light": "bg" },
    "backgroundPanel": { "dark": "bgPanel", "light": "bgPanel" },
    "backgroundElement": { "dark": "bgHighlight", "light": "bgHighlight" },
    "border": { "dark": "border", "light": "border" },
    "borderActive": { "dark": "borderLight", "light": "borderLight" },
    "borderSubtle": { "dark": "border", "light": "border" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "fgDim", "light": "fgDim" },
    "diffHunkHeader": { "dark": "border", "light": "border" },
    "diffHighlightAdded": { "dark": "green", "light": "green" },
    "diffHighlightRemoved": { "dark": "orange", "light": "orange" },
    "diffAddedBg": { "dark": "bgHighlight", "light": "bgHighlight" },
    "diffRemovedBg": { "dark": "bgHighlight", "light": "bgHighlight" },
    "diffContextBg": { "dark": "bgPanel", "light": "bgPanel" },
    "diffLineNumber": { "dark": "border", "light": "border" },
    "diffAddedLineNumberBg": { "dark": "bgPanel", "light": "bgPanel" },
    "diffRemovedLineNumberBg": { "dark": "bgPanel", "light": "bgPanel" },
    "markdownText": { "dark": "fg", "light": "fg" },
    "markdownHeading": { "dark": "purple", "light": "purple" },
    "markdownLink": { "dark": "blue", "light": "blue" },
    "markdownLinkText": { "dark": "cyan", "light": "cyan" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "gray", "light": "gray" },
    "markdownEmph": { "dark": "orange", "light": "orange" },
    "markdownStrong": { "dark": "yellow", "light": "yellow" },
    "markdownHorizontalRule": { "dark": "border", "light": "border" },
    "markdownListItem": { "dark": "purple", "light": "purple" },
    "markdownListEnumeration": { "dark": "blue", "light": "blue" },
    "markdownImage": { "dark": "blue", "light": "blue" },
    "markdownImageText": { "dark": "cyan", "light": "cyan" },
    "markdownCodeBlock": { "dark": "fg", "light": "fgDim" },
    "syntaxComment": { "dark": "gray", "light": "gray" },
    "syntaxKeyword": { "dark": "purple", "light": "purple" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "cyan", "light": "cyan" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "orange", "light": "orange" },
    "syntaxType": { "dark": "yellow", "light": "yellow" },
    "syntaxOperator": { "dark": "red", "light": "red" },
    "syntaxPunctuation": { "dark": "fg", "light": "fg" }
