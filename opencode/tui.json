{
  "$schema": "https://opencode.ai/tui.json",
  "plugin": ["oh-my-openagent@latest"],
  "theme": "catppuccin-no-bg",
  "leader_timeout": 2000,
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "diff_style": "auto",
  "mouse": true,
  "keybinds": {
    "leader": "ctrl+x",
    "command_list": "ctrl+p"
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 1,
    "sound_pack": "opencode.default"
  }
}
