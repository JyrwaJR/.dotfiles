{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "mkdir *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "source *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "git checkout -b*": "allow",
      "git branch*": "allow",
      "git push --force*": "ask",
      "grep *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "curl *": "ask",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "eval *": "deny",
      "exec *": "deny",
      "nc *": "deny",
      "netcat *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*-key.json": "deny",
      "*secrets*": "deny",
      "*credentials*": "deny"
    },
    "edit": "allow",
    "external_directory": {
      "~/.dotfiles/**": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/tmp/**": "allow",
      "/tmp/**": "allow",
      "/var/tmp/**": "allow",
      "~/src/**": "allow",
      "~/Desktop/**": "allow",
      "~/Downloads/**": "allow",
      "~/Library/Mobile Documents/iCloud~md~obsidian/Documents/plannotator":"allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "*": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "glob": "allow",
    "grep": "allow",
    "skill": "allow",
    "lsp": "allow",
    "question": "allow"
  },
  "skills": {
    "paths": [
      "skills"
    ]
  },
  "plugin": [
    "opencode-antigravity-auth@latest",
    "superpowers@git+https://github.com/obra/superpowers.git#v5.1.0",
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "all-agents"
      }
    ]
  ],
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "memories": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@memories.sh/cli",
        "serve"
      ],
      "environment": {
        "MEMORIES_DATA_DIR": "/Users/harrison/.dotfiles/opencode/memory/db"
      }
    },
    "shadcn": {
      "command": [
        "npx",
        "-y",
        "shadcn@latest",
        "mcp"
      ],
      "type": "local",
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp",
        "--executablePath",
        "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "enabled": true
    }
  },
  "username": "harrison",
  "logLevel": "INFO",
  "autoupdate": "notify",
  "snapshot": true,
  "instructions": [
    "AGENTS.md"
  ],
  "default_agent": "build",
  "agent": {
    "plan": {
      "description": "Creates structured plans and deep reasoning for complex problems",
      "permission": {
        "edit": "deny",
        "bash": { "*": "ask" }
      }
    },
    "build": {
      "description": "Executes implementation, runs verification, refactors, documents, and commits"
    }
  },
  "provider": {
    "google": {
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "minimal": {
              "thinkingLevel": "minimal"
            },
            "low": {
              "thinkingLevel": "low"
            },
            "medium": {
              "thinkingLevel": "medium"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "antigravity-claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-3-pro-preview": {
          "name": "Gemini 3 Pro Preview (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-3.1-pro-preview-customtools": {
          "name": "Gemini 3.1 Pro Preview Custom Tools (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "formatter": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "command": {
    "fix": {
      "description": "Fix code issues found during review or build",
      "template": "Load build-error-resolver skill if the issue is a build/type error. Read review findings, lint errors, or test failures from the working tree. Implement minimal fixes — do not refactor beyond the fix. Re-verify after fixing."
    },
    "review": {
      "description": "Request a code review of current changes",
      "template": "Load requesting-code-review skill. Dispatch a code-reviewer subagent to review changes. Provide git diff context and plan context if available. Organize findings by severity: Critical, High, Medium, Low, Nit. Fix critical/high findings before proceeding."
    },
    "deploy": {
      "description": "Deploy the current branch",
      "template": "Deploy the current branch to production following the project's deployment process."
    },
    "plan": {
      "description": "Create an implementation plan",
      "agent": "plan",
      "template": "Create a detailed implementation plan for the requested feature or change."
    },
    "brainstorm": {
      "description": "Explore ideas, requirements, and design before implementation",
      "template": "Load the brainstorming skill and explore the idea. Ask clarifying questions, propose 2-3 approaches with trade-offs, and converge on a design direction. Hand off to /plan when ready."
    },
    "build": {
      "description": "Execute implementation based on existing plan",
      "agent": "build",
      "template": "Execute the active implementation plan. Read the plan, identify the next unchecked task, and implement it following TDD."
    },
    "commit": {
      "description": "Stage and commit related changes with Conventional Commit messages",
      "agent": "build",
      "subtask": true,
      "template": "Analyze working tree with git status and git diff. Group related files by path and diff content. Commit with Conventional Commit types (feat:, fix:, chore:, refactor:, docs:, test:). Verify tests pass before committing. Never commit secrets or .env files."
    },
    "debug": {
      "description": "Systematic root-cause debugging before proposing fixes",
      "agent": "plan",
      "template": "Load the systematic-debugging skill. Follow four phases: Reproduce (confirm bug), Investigate (read errors/logs), Hypothesize (form and test root-cause hypotheses), Fix (minimal fix with verification). Use sequential-thinking MCP for complex reasoning. No fixes without root cause."
    },
    "security": {
      "description": "Run a comprehensive security review",
      "subtask": true,
      "template": "Load security-reviewer and owasp-security skills. Scan for OWASP Top 10 vulnerabilities (A01-A10), hardcoded secrets, SSRF, injection, auth failures, and misconfigurations. Report findings as Critical/High/Recommendations. Security issues are blockers."
    },
    "think": {
      "description": "Deep reasoning for complex problems using sequential thinking",
      "agent": "plan",
      "subtask": true,
      "template": "Use sequential-thinking MCP tool to reason step-by-step: Understand, Inspect, Decompose, Explore alternatives, Evaluate trade-offs, Recommend approach, Create implementation plan, Check edge cases, Verify consistency. Output structured analysis. Do not write code."
    },
    "verify": {
      "description": "Run verification gate before claiming work is complete",
      "agent": "build",
      "subtask": true,
      "template": "Load verification-before-completion skill. Run fresh verification: tests (npm test), build (npm run build), lint (npm run lint), type check (tsc --noEmit). Read actual output — do not assume success. Fix failures before claiming completion."
    }
  },
  "experimental": {
    "mcp_timeout": 30000
  },
  "shell": "sh"
}
