{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "sudo *": "deny",
      "rm -rf *": "deny",
      "eval *": "deny",
      "exec *": "deny",
      "nc *": "deny",
      "netcat *": "deny",
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "source *": "allow"
    },
    "read": {
      "*": "allow",
      "**/.env*": "deny",
      "**/.env.*": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*-key.json": "deny",
      "**/secrets/**": "deny",
      "**/credentials*": "deny"
    },
    "edit": {
      "**/opencode.jsonc": "ask",
      "**/opencode.json": "ask",
      "**/AGENTS.md": "ask",
      "**/SKILL.md": "allow",
      "**/*.md": "allow",
      "**/*.json": "allow",
      "**/*.jsonc": "allow",
      "**/*.ts": "allow",
      "**/*.tsx": "allow",
      "**/*.js": "allow",
      "**/*.mjs": "allow",
      "*": "ask"
    },
    "external_directory": {
      "~/.dotfiles/**": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/tmp/**": "allow",
      "/tmp/**": "allow",
      "/var/tmp/**": "allow",
      "~/projects/**": "allow",
      "~/src/**": "allow",
      "~/Desktop/**": "allow",
      "~/Downloads/**": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "*": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "todowrite": "allow"
  },
  "skills": { "paths": ["skills"] },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git#v5.1.0",
    ["@plannotator/opencode@latest", {
      "workflow": "all-agents",
      "planningAgents": ["plan","build"]
    }]
  ],
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "memories": {
       "type": "local",
       "command": ["npx", "-y", "@memories.sh/cli", "serve"],
       "environment": {
          "MEMORIES_DATA_DIR": "/Users/harrison/.dotfiles/opencode/memory/db"
       }
     },
    "shadcn": {
      "command": ["npx", "-y", "shadcn@latest", "mcp"],
      "type":"local",
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp", "--executablePath", "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": true
    }
  }
}
