{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "sudo *": "deny",
      "rm -rf *": "deny",
      "eval *": "deny",
      "exec *": "deny",
      "nc *": "deny",
      "netcat *": "deny",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "source *": "allow",
      "git **": "allow"
    },
    "read": {
      "*": "allow",
      "**/.env*": "deny",
      "**/.env.*": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*-key.json": "deny",
      "**/secrets/**": "deny",
      "**/credentials*": "deny"
    },
    "edit": "allow",
    "external_directory": {
      "~/.dotfiles/**": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/tmp/**": "allow",
      "/tmp/**": "allow",
      "/var/tmp/**": "allow",
      "~/src/**": "allow",
      "~/Desktop/**": "allow",
      "~/Downloads/**": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "*": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "todowrite": "allow"
  },
  "skills": { "paths": ["skills"] },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git#v5.1.0",
    ["@plannotator/opencode@latest", {
      "workflow": "all-agents",
      "planningAgents": ["plan","build"]
    }]
  ],
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "memories": {
       "type": "local",
       "command": ["npx", "-y", "@memories.sh/cli", "serve"],
       "environment": {
          "MEMORIES_DATA_DIR": "/Users/harrison/.dotfiles/opencode/memory/db"
       }
     },
    "shadcn": {
      "command": ["npx", "-y", "shadcn@latest", "mcp"],
      "type":"local",
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp", "--executablePath", "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": true
    }
  },
  "username": "harrison",
  "logLevel": "INFO",
  "autoupdate": "notify",
  "snapshot": true,
  "instructions": ["AGENTS.md"],
  "default_agent": "planner",
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/deepseek-v4-flash-free",
  "formatter": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "command": {
    "fix": {
      "description": "Fix code issues found during review or build",
      "template": "Fix the issues found in the current codebase. Read any review findings, lint errors, or test failures, then implement fixes."
    },
    "review": {
      "description": "Request a code review of current changes",
      "template": "Review all uncommitted changes in the working tree for quality, correctness, and security issues."
    },
    "deploy": {
      "description": "Deploy the current branch",
      "template": "Deploy the current branch to production following the project's deployment process."
    },
    "plan": {
      "description": "Create an implementation plan",
      "template": "Create a detailed implementation plan for the requested feature or change."
    }
  },
  "experimental": {
    "mcp_timeout": 30000
  },
  "agent": {
    "brainstormer": {
      "model": "opencode/deepseek-v4-flash-free",
      "steps": 50
    },
    "planner": {
      "model": "opencode/deepseek-v4-flash-free",
      "steps": 30
    },
    "build": {
      "model": "opencode/deepseek-v4-flash-free",
      "steps": 100
    },
    "review": {
      "model": "opencode/nemotron-3-ultra-free",
      "steps": 30
    }
  }
}
