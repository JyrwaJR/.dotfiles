{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "mkdir *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "source *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "git *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "curl *": "ask",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "eval *": "deny",
      "exec *": "deny",
      "nc *": "deny",
      "netcat *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*-key.json": "deny",
      "*secrets*": "deny",
      "*credentials*": "deny"
    },
    "edit": "allow",
    "external_directory": {
      "~/.dotfiles/**": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/tmp/**": "allow",
      "/tmp/**": "allow",
      "/var/tmp/**": "allow",
      "~/src/**": "allow",
      "~/Desktop/**": "allow",
      "~/Downloads/**": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "*": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "glob": "allow",
    "grep": "allow",
    "skill": "allow",
    "lsp": "allow",
    "question": "allow"
  },
  "skills": {
    "paths": [
      "skills"
    ]
  },
  "plugin": [
    "opencode-antigravity-auth@latest",
    "superpowers@git+https://github.com/obra/superpowers.git#v5.1.0",
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "plan-agent",
        "planningAgents": [ "plan","build" ]
      }
    ]
  ],
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "memories": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@memories.sh/cli",
        "serve"
      ],
      "environment": {
        "MEMORIES_DATA_DIR": "/Users/harrison/.dotfiles/opencode/memory/db"
      }
    },
    "shadcn": {
      "command": [
        "npx",
        "-y",
        "shadcn@latest",
        "mcp"
      ],
      "type": "local",
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp",
        "--executablePath",
        "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "enabled": true
    }
  },
  "username": "harrison",
  "logLevel": "INFO",
  "autoupdate": "notify",
  "snapshot": true,
  "instructions": [
    "AGENTS.md"
  ],
  "default_agent": "build",
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/deepseek-v4-flash-free",
  "agent": {
    "plan": {
      "description": "Creates structured plans and deep reasoning for complex problems",
      "model": "opencode/deepseek-v4-flash-free",
      "permission": {
        "edit": "deny",
        "bash": { "*": "ask" }
      }
    },
    "build": {
      "description": "Executes implementation, runs verification, refactors, documents, and commits",
      "model": "opencode/deepseek-v4-flash-free"
    }
  },
  "provider": {
    "google": {
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "minimal": {
              "thinkingLevel": "minimal"
            },
            "low": {
              "thinkingLevel": "low"
            },
            "medium": {
              "thinkingLevel": "medium"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "antigravity-claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-3-pro-preview": {
          "name": "Gemini 3 Pro Preview (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-3.1-pro-preview-customtools": {
          "name": "Gemini 3.1 Pro Preview Custom Tools (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "formatter": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "command": {
    "fix": {
      "description": "Fix code issues found during review or build",
      "template": "Fix the issues found in the current codebase. Read any review findings, lint errors, or test failures, then implement fixes."
    },
    "review": {
      "description": "Request a code review of current changes",
      "template": "Review all uncommitted changes in the working tree for quality, correctness, and security issues."
    },
    "deploy": {
      "description": "Deploy the current branch",
      "template": "Deploy the current branch to production following the project's deployment process."
    },
    "plan": {
      "description": "Create an implementation plan",
      "agent": "plan",
      "template": "Create a detailed implementation plan for the requested feature or change."
    },
    "brainstorm": {
      "description": "Explore ideas, requirements, and design before implementation",
      "template": "Explore the idea or problem described. Ask clarifying questions, explore approaches, and produce a design direction."
    },
    "build": {
      "description": "Execute implementation based on existing plan",
      "agent": "build",
      "template": "Execute the active implementation plan. Read the plan, identify the next unchecked task, and implement it following TDD."
    },
    "commit": {
      "description": "Stage and commit related changes with Conventional Commit messages",
      "agent": "build",
      "subtask": true,
      "template": "Analyze the working tree with git status and git diff. Group related files and commit with Conventional Commit types (feat:, fix:, chore:, refactor:, docs:, test:)."
    },
    "debug": {
      "description": "Systematic root-cause debugging before proposing fixes",
      "agent": "plan",
      "template": "Load the systematic-debugging skill and follow its four-phase process: root cause investigation, pattern analysis, hypothesis testing, then implementation. No fixes without root cause."
    },
    "security": {
      "description": "Run a comprehensive security review",
      "subtask": true,
      "template": "Conduct a comprehensive security review of the current codebase following OWASP guidelines and security best practices."
    },
    "think": {
      "description": "Deep reasoning for complex problems using sequential thinking",
      "agent": "plan",
      "subtask": true,
      "template": "Use the sequential-thinking MCP tool to reason through this problem step-by-step. Break it down, explore alternatives, and reach a conclusion."
    },
    "verify": {
      "description": "Run verification gate before claiming work is complete",
      "agent": "build",
      "subtask": true,
      "template": "Run the verification-before-completion workflow. Check that all tests pass, build succeeds, and no lint errors exist before reporting completion."
    }
  },
  "experimental": {
    "mcp_timeout": 30000
  },
  "shell": "bash"
}
